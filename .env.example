# AI Supply Chain - Environment Variables
# Copy this file to .env.local for local development 
# Or configure these in your cloud provider for production deployment

# The deployed smart contract address on your production network
VITE_CONTRACT_ADDRESS="0xYourDeployedContractAddressHere"

# Anvil RPC URL — set this to your GCP VM's public IP before building
# Local dev: leave empty (defaults to http://127.0.0.1:8545)
# Production: VITE_ANVIL_RPC_URL=http://<your-vm-ip>:8545
VITE_ANVIL_RPC_URL="http://127.0.0.1:8545"

# Gemini API Key for AI features
VITE_GEMINI_API_KEY="your_gemini_api_key_here"

# Note: The app automatically detects if it's running in production (via Vite's build process)
# In production it will default to Mainnet/Sepolia networks
# In development it will default to Anvil/Localhost network
